{
  "name": "studio-console",
  "version": "0.31.3",
  "private": true,
  "description": "监制台：AI 工作室制作人驾驶舱。工单 .md 是唯一事实源，目录即状态机。",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node 跑测试.js"
  },
  "dependencies": {
    "express": "^4.19.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.studio.console",
    "productName": "监制台",
    "directories": {
      "output": "D:/studio-build/dist"
    },
    "files": [
      "main.js",
      "server.js",
      "lib/**",
      "public/**",
      "node_modules/**",
      "preload.js"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "build-assets/icon.ico"
    }
  },
  "author": "suxing412"
}
