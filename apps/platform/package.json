{
  "name": "ai-devplatform",
  "version": "0.1.0",
  "private": true,
  "description": "通用软件开发平台 · 交钥匙壳（施工令-025 出厂）。零第三方依赖，node 内置模块 only。",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/开机.js",
    "server": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable",
    "check": "node scripts/自查语法.js",
    "test": "node test/公用件契约.test.js && node test/接线契约.test.js && node test/工单库契约.test.js && node test/执行链契约.test.js && node test/产线契约.test.js && node test/资产接线.test.js && node test/视图契约.test.js",
    "workspace": "node scripts/工作区服务.js",
    "executor": "node scripts/执行器.js",
    "watchtower": "node scripts/watchtower.js",
    "watchtower:install": "node scripts/watchtower.js --install",
    "watchtower:status": "node scripts/watchtower.js --status"
  },
  "author": "robinwang2",
  "license": "UNLICENSED",
  "build": {
    "appId": "local.aidevplatform",
    "productName": "AI-DevPlatform",
    "electronVersion": "30.5.1",
    "files": [
      "main.js",
      "server.js",
      "public/**",
      "lib/**",
      "角色协议模板/**",
      "docs/**",
      "scripts/**",
      "config/**",
      "!config/*.local.json",
      "!config/api-token.txt"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}
